<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="315"
                android:startColor="#6B7EA9D3"
                android:centerColor="#536F91BE"
                android:endColor="#45516B91" />
            <stroke android:width="1dp" android:color="#DBECFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="315"
                android:startColor="#43587297"
                android:endColor="#302A3D58" />
            <stroke android:width="1dp" android:color="#607AABD7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</selector>
