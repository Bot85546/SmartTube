<?xml version="1.0" encoding="utf-8"?>
<!-- The system draws this while Android starts the lightweight launcher.
     The wordmark is transparent, so there is no embedded rectangle or rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/pitube_launch_surface" />
    <item>
        <bitmap
            android:src="@drawable/pitube_wordmark"
            android:gravity="center"
            android:filter="true" />
    </item>
</layer-list>
