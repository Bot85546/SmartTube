<?xml version="1.0" encoding="utf-8"?>
<!-- Slim translucent-looking chrome remains on every Browse section. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F0152133"
                android:endColor="#DA111929" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#28445F83" />
        </shape>
    </item>
</layer-list>
