<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded static gradients are inexpensive to draw on older Android TVs. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="#536A92B8"
                android:centerColor="#3A496987"
                android:endColor="#2C293A53" />
            <stroke android:width="1dp" android:color="#ADD6ECFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/pradi_surface" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
