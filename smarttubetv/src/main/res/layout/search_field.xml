<?xml version="1.0" encoding="utf-8"?>
<!-- Channel filtering is a compact glass search field, not a default underline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/simple_edit_config"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/simple_edit_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:singleLine="true"
        android:autofillHints=""
        android:hint="@string/channel_filter_hint"
        android:imeOptions="actionDone"
        android:inputType="textPersonName"
        android:textSize="16sp"
        android:textColor="#F2F6FF"
        android:textColorHint="#9FB2CD"
        android:background="@drawable/pitube_channel_search_bg" />
</LinearLayout>
